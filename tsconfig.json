{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "ESNext"],
    "module": "esnext",
    "strict": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "ES2020"
    }
  }
}
